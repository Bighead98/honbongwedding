{
  "name": "hojeong-sojeong-invitation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --logLevel warn && tsx scripts/check-release.ts",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "check:release": "tsx scripts/check-release.ts",
    "check:publish": "tsx scripts/check-release.ts --strict",
    "deploy:check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy:workers": "npm run check:publish && npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/nanum-pen-script": "5.3.0",
    "@sun-typeface/suit": "2.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "wrangler": "4.147.0"
  }
}
